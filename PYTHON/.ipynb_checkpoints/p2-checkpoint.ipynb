   "source": [
    "a = int(input(\"Enter first number: \"))\n",
    "b = int(input(\"Enter second number: \"))\n",
    "num1 = a\n",
    "num2 = b\n",
    "while b != 0:\n",
    "    a, b = b, a % b\n",
    "gcd = a\n",
    "lcm = (num1 * num2) // gcd\n",
    "print(\"GCD =\", gcd)\n",
    "print(\"LCM =\", lcm)"
   ]
  }
 ],
