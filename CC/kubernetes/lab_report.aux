\@writefile{toc}{\contentsline {chapter}{Setup --- Building the Cluster}{5}{chapter*.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Setup --- Creating the kind cluster. The configuration is written and \texttt  {kind create cluster} runs successfully, completing all phases: Ensuring node image, Preparing nodes, Writing configuration, Starting control-plane, Installing CNI, Installing StorageClass, and Joining worker nodes.}}{6}{figure.0.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Setup --- All three nodes (\texttt  {k8s-lab-control-plane}, \texttt  {k8s-lab-worker}, \texttt  {k8s-lab-worker2}) are \texttt  {Ready} running Kubernetes v1.34.0.}}{6}{figure.0.2}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\numberline {1}Look at Your Cluster}{7}{chapter.1}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {section}{\numberline {1.1}Checking the Current Context and Nodes}{7}{section.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Step 1 --- Current context is \texttt  {kind-k8s-lab}. Nodes listed with internal IPs and container runtime (containerd 2.1.3). \texttt  {kubectl get pods} returns ``No resources found in default namespace'' --- correct, nothing deployed yet.}}{7}{figure.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {1.2}Why Apps Never Run on the Control Plane}{7}{section.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {1.3}System Pods in kube-system}{8}{section.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Step 1 --- System pods in the \texttt  {kube-system} namespace. All are \texttt  {Running} with 0 restarts. Control-plane pods (\texttt  {etcd}, \texttt  {kube-apiserver}, \texttt  {kube-controller-manager}, \texttt  {kube-scheduler}, \texttt  {coredns}) run only on the control-plane node. Networking pods (\texttt  {kube-proxy}, \texttt  {kindnet}) run on all three nodes.}}{8}{figure.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\numberline {2}Run Your First App}{9}{chapter.2}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {section}{\numberline {2.1}Creating the Deployment YAML}{9}{section.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2.2}Applying the Deployment}{10}{section.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Step 2 --- Dry-run passes, deployment created, and \texttt  {kubectl wait} confirms \texttt  {condition met}. Three nginx pods (\texttt  {nginx-676775dcc5-h9t66}, \texttt  {-nbj8k}, \texttt  {-szlfw}) are \texttt  {Running} across both worker nodes.}}{10}{figure.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2.3}One File, Three Objects}{10}{section.2.3}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\numberline {3}Open it in a Browser}{11}{chapter.3}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {section}{\numberline {3.1}Creating the Service YAML}{11}{section.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.2}Applying the Service and Checking Endpoints}{11}{section.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Step 3 --- Service applied. \texttt  {kubectl get services} shows the nginx NodePort Service on \texttt  {80:30000/TCP}. \texttt  {kubectl get endpoints nginx} lists three endpoints (one per Pod) at their respective IPs --- proof that label matching worked.}}{12}{figure.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.3}Visiting the App in the Browser}{12}{section.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Step 3 --- The \textbf  {``Welcome to nginx!''} page is displayed at \texttt  {localhost:30000}. The NodePort Service is forwarding traffic from the control-plane node through to a running Pod on a worker node.}}{12}{figure.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.4}Port Mapping Summary}{12}{section.3.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.5}Quick Tunnel Alternative}{13}{section.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Step 3 / 4 combined --- \texttt  {kubectl port-forward} active in one terminal while \texttt  {kubectl scale --replicas=5} is run in another. The scaling shows two new pods in \texttt  {ContainerCreating}. Endpoints still show only the original three until new pods become Ready.}}{13}{figure.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\numberline {4}Scale It, Then Kill It}{14}{chapter.4}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {section}{\numberline {4.1}Scale Up to 5 Replicas}{14}{section.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Scale Back Down to 3}{14}{section.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Step 4 --- After scaling back to 3. All three Pods are \texttt  {Running} and distributed across both worker nodes (\texttt  {k8s-lab-worker} and \texttt  {k8s-lab-worker2}).}}{14}{figure.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.3}Deliberately Deleting a Pod}{14}{section.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Step 4 --- Three pods listed before deletion. Pod \texttt  {nginx-676775dcc5-szlfw} was selected for deletion to demonstrate self-healing.}}{15}{figure.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\numberline {5}Update, Redeploy, Undo}{16}{chapter.5}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {section}{\numberline {5.1}5.1 --- Imperative Update}{16}{section.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Step 5.1 --- Imperative image update to \texttt  {nginx:stable-alpine}. Rolling update: 1 new replica updated, then 2, then old replicas terminate. Final message: ``deployment \texttt  {nginx} successfully rolled out''. The site remained accessible throughout.}}{16}{figure.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5.2}5.2 --- Declarative Update}{16}{section.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Step 5.2 --- Declarative \texttt  {kubectl apply -f deployment.yaml}. Status shows \texttt  {configured} and the rolling update completes successfully. This approach is standard in production --- changes live in Git and are reproducible.}}{17}{figure.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5.3}5.3 --- Rollback}{17}{section.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5.4}5.4 --- Idempotent Apply (Nothing Changed)}{17}{section.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Step 5.4 --- After the update, three pods from the new ReplicaSet (\texttt  {nginx-5587d869bc-*}) are \texttt  {Running}. Applying the same unchanged YAML returns \texttt  {deployment.apps/nginx unchanged} --- \texttt  {apply} is fully idempotent.}}{17}{figure.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\numberline {6}Break It and Fix It}{18}{chapter.6}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {section}{\numberline {6.1}6.1 --- Deliberately Break the Deployment}{18}{section.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6.2}6.2 --- Diagnose with \texttt  {describe}}{18}{section.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces Step 6 --- \texttt  {kubectl describe pod} on the broken pod. Full metadata visible: Pod assigned to \texttt  {k8s-lab-worker}, Status \texttt  {Running}, Labels, Container details (image: caddy, Port: 80/TCP). Events section at bottom shows the full lifecycle trace.}}{19}{figure.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces Step 6 --- Continuation of \texttt  {kubectl describe pod}. Container conditions all \texttt  {True}, Volumes, QoS Class (\texttt  {Burstable}), Tolerations, and Events: Scheduled $\to $ Pulling $\to $ Pulled (26s) $\to $ Running. For a broken pod the Events section would instead show \texttt  {Failed} and \texttt  {ImagePullBackOff}.}}{19}{figure.6.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6.3}6.3 --- Try \texttt  {logs} (and understand why it fails here)}{20}{section.6.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6.4}6.4 --- Fix It}{20}{section.6.4}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{Bonus: Declarative Image Update Result}{21}{chapter*.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces Caddy web server running at \texttt  {localhost:30000} after the rolling update. The page reads ``Your web server is working. Now make it work for you.'' --- confirming the Kubernetes rolling update mechanism replaced all Pods without downtime.}}{21}{figure.6.3}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{Cleanup}{22}{chapter*.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces Cleanup --- \texttt  {kubectl rollout undo} completes the rollback, then \texttt  {kubectl delete -f service.yaml} and \texttt  {kubectl delete -f deployment.yaml} remove the app. \texttt  {kubectl get all} confirms only the built-in \texttt  {service/kubernetes} remains. Finally, \texttt  {kind delete cluster --name k8s-lab} deletes all three container nodes and \texttt  {kind get clusters} returns nothing.}}{22}{figure.6.4}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{Summary and Conclusion}{23}{chapter*.6}\protected@file@percent }
